<div class="text-right mb-3">
    <div class="dropdown">
        <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa fa-plus-circle"></i> {{#str}}createbadgecriteria, local_ultimate{{/str}}
        </button>
        <ul class="dropdown-menu">
            {{#criteriamethods}}
                <li><a class="dropdown-item" data-action="open-criteria-modal" data-criteria="{{name}}" href="#">{{displayname}}</a></li>
            {{/criteriamethods}}
        </ul>
    </div>
</div>

<table class="table table-bordered table-hover table-ultimate-badgecriterias">
    <thead class="thead-dark">
    <tr>
        <th scope="col">#</th>
        <th scope="col">{{#str}}criteriamethod, local_ultimate{{/str}}</th>
        <th scope="col">{{#str}}criteriatarget, local_ultimate{{/str}}</th>
        <th scope="col">{{#str}}criteriavalue, local_ultimate{{/str}}</th>
        <th scope="col">{{#str}}actions, local_ultimate{{/str}}</th>
    </tr>
    </thead>
    <tbody>
    {{#criterias}}
        <tr>
            <th scope="row">{{{id}}}</th>
            <td>{{{method}}}</td>
            <td>{{{target}}}</td>
            <td>{{{value}}}</td>
            <td style="width: 120px; text-align: center;">
                <a href="#" data-id="{{id}}" class="btn btn-danger btn-sm delete-ultimate-badgecriteria"><i class="fa fa-trash-o"></i></a>
            </td>
        </tr>
    {{/criterias}}
    </tbody>
</table>

{{#js}}
    require(['local_ultimate/badgecriteria/create', 'local_ultimate/badgecriteria/delete'], function(CreateBadgeCriteria, DeleteBadgeCriteria) {
        CreateBadgeCriteria.init({{{courseid}}}, {{{badgeid}}}, {{{contextid}}});

        DeleteBadgeCriteria.init();
    });
{{/js}}