<div class="text-right mb-3">
    <a href="#"
       class="btn btn-primary" data-action="create-badge-modal">
        <i class="fa fa-plus-circle"></i> {{#str}}createbadge, local_ultimate{{/str}}
    </a>
</div>

<table class="table table-bordered table-hover table-ultimate-badges">
    <thead class="thead-dark">
    <tr>
        <th scope="col">#</th>
        <th scope="col">{{#str}}name, local_ultimate{{/str}}</th>
        <th scope="col">{{#str}}actions, local_ultimate{{/str}}</th>
    </tr>
    </thead>
    <tbody>
    {{#badges}}
        <tr>
            <th scope="row">{{{id}}}</th>
            <td>{{{name}}}</td>
            <td style="width: 160px; text-align: center;">
                <a href="#" data-id="{{id}}" class="btn btn-info btn-sm deliver-ultimate-badge" title="{{#str}}badgedeliver, local_ultimate{{/str}}">
                    <i class="fa fa-refresh"></i>
                </a>
                <a href="{{{config.wwwroot}}}/local/ultimate/badgecriterias.php?id={{id}}" data-id="{{id}}" class="btn btn-primary btn-sm" title="{{#str}}badgecriteria, local_ultimate{{/str}}">
                    <i class="fa fa-cog"></i>
                </a>
                <a href="#" data-id="{{id}}" data-name="{{name}}" data-description="{{description}}" data-badgeid="{{badgeid}}" class="btn btn-warning btn-sm edit-ultimate-badge" title="{{#str}}editbadge, local_ultimate{{/str}}">
                    <i class="fa fa-pencil-square-o text-white"></i>
                </a>
                <a href="#" data-id="{{id}}" class="btn btn-danger btn-sm delete-ultimate-badge" title="{{#str}}deletebadge, local_ultimate{{/str}}">
                    <i class="fa fa-trash-o"></i>
                </a>
            </td>
        </tr>
    {{/badges}}
    </tbody>
</table>

{{#js}}
    require(['local_ultimate/badge/create', 'local_ultimate/badge/edit', 'local_ultimate/badge/delete', 'local_ultimate/badge/deliver'], function(CreateBadge, EditBadge, DeleteBadge, DeliverBadge) {
        CreateBadge.init('[data-action=create-badge-modal]', {{{contextid}}}, {{{courseid}}});

        EditBadge.init({{{contextid}}});

        DeleteBadge.init();

        DeliverBadge.init();
    });
{{/js}}